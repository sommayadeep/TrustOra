# Copy this file to apps/web/.env.local for local development.
# Never commit real credentials. Do not put wallet private keys in the web app.

# Arc Testnet (5042002). Add a contract address only after an authorized deployment.
ARC_RPC_URL=https://rpc.testnet.arc.io
ESCROW_CONTRACT_ADDRESS=

# Optional genuine 0G Router testnet inference. Leave blank to use UNABLE_TO_ASSESS.
ZG_ROUTER_API_KEY=
# Optional; defaults to the testnet router below when a key is configured.
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
ZG_ROUTER_MODEL=glm-5.3
ZG_ROUTER_TRUST_MODE=private
ZG_ROUTER_PROVIDER_ADDRESS=

# SQLite location is fixed in prisma/schema.prisma. No DATABASE_URL is needed.
# Hedera x402 stays disabled unless all testnet facilitator/service settings are present.
# Never expose a private key to browser code or through a NEXT_PUBLIC_ variable.
# Agent, facilitator and recipient must be three different accounts:
#   agent        signs and pays each service price
#   facilitator  co-signs, submits and pays network fees; it may not fund the payment itself
#   recipient    receives the payment; only its account ID is needed here
# Keys may be DER hex, 0x-prefixed ECDSA hex, or bare ED25519 hex.
# Check with: npm run preflight:hedera
HEDERA_FACILITATOR_ACCOUNT_ID=
HEDERA_FACILITATOR_PRIVATE_KEY=
HEDERA_SERVICE_RECIPIENT=
HEDERA_SECURITY_SCAN_TINYBARS=10000000
# Comma-separated Hedera account IDs or service hostnames. Include HEDERA_SERVICE_RECIPIENT here,
# or the spending policy rejects the payment before anything is signed.
HEDERA_ALLOWED_PROVIDERS=
# Optional overrides. Autonomous mode only pays a service on the same origin as the app.
# TRUSTORA_SERVICE_BASE_URL=http://localhost:3000
# HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# Dedicated Hedera testnet agent wallet. Never use a user's/main wallet here.
# Keep the key server-only; autonomous signing stays disabled unless explicitly enabled.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
# Algorithm of each key: ED25519 or ECDSA_SECP256K1. Optional but recommended: when set, a key of
# the wrong algorithm is rejected instead of silently producing an unusable signer. A bare 32-byte
# hex string is a valid key for BOTH algorithms, so it cannot be detected from the value alone.
# Leave blank to use the convention 0x-prefixed = ECDSA, bare hex = ED25519 (DER keys self-describe).
HEDERA_AGENT_KEY_TYPE=
HEDERA_FACILITATOR_KEY_TYPE=
HEDERA_AGENT_AUTOPAY_ENABLED=false
# true requires approval on each payment; set false only after intentionally approving
# an autonomous policy for this limited-funds testnet agent wallet.
HEDERA_AGENT_REQUIRE_APPROVAL=true

# Legacy wallet for HederaAgentPayer. The x402 flow does not read these. Must differ from the agent.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

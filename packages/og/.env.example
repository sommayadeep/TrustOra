# NAMES ONLY. Never put real values here. Set real values in your local shell / untracked .env.local.
# 0G TESTNET ONLY. Mainnet router (router-api.0g.ai) and mainnet RPC are refused in code.

# --- Primary: 0G Private Computer Router (testnet UI: https://pc.testnet.0g.ai) ---
ZG_ROUTER_API_KEY=
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
ZG_ROUTER_MODEL=glm-5.3
ZG_ROUTER_TRUST_MODE=private
ZG_ROUTER_PROVIDER_ADDRESS=    # optional; pins a provider via X-0G-Provider-Address

# --- Fallback: compute broker SDK (needs ledger >= 3 0G, provider sub-account >= 1 0G) ---
ZG_PRIVATE_KEY=                # testnet-only throwaway wallet
ZG_RPC_URL=                    # optional; default https://evmrpc-testnet.0g.ai (UNVERIFIED)
ZG_PROVIDER_ADDRESS=           # optional
